@{
    ViewData["Title"] = "Creadit Memo";
}
@inject IConfiguration Configuration
  @{
    var API_BASE_URL = $"{Configuration["API_BASE_URL"]}";
    var API_KEY = Configuration.GetSection("ApiSettings").GetValue<string>("ApiKey");
    var API_VALUE = Configuration.GetSection("ApiSettings").GetValue<string>("ApiPassword");
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyPortal</title>

    <link rel="stylesheet" href="~/css/Orders.css" asp-append-version="true" />

</head>

<body>
    <div id="loading" class="loading" style="display: none;">
        <div class="spinner"></div>
        <p>Loading...</p>
    </div>
    <div class="Orders-container">
        <div class="mobile-header">
            <button id="menu-toggle" class="menu-toggle">
                <i class="fas fa-bars"></i>
            </button>
        </div>
        <nav class="sidebar" id="sidebar">
            <ul>
                <li><a href="@($"{API_BASE_URL}")/Home/Customer_Home"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                <li><a href="@($"{API_BASE_URL}")/Home/Orders"><i class="fas fa-users me-2"></i>Orders</a></li>
                <li><a href="@($"{API_BASE_URL}")/Home/Invoices"><i class="fa-solid fa-file-lines me-2"></i>Invoices</a></li>
                <li><a href="@($"{API_BASE_URL}")/Home/Quotes"><i class="fa-solid fa-pen-to-square me-2"></i>Quotes</a></li>
                <li><a href="#" id="Credit_Memo-link"><i class="fa-solid fa-book me-2"></i>Credit Memo</a></li>
            </ul>
            <button class="logout-button" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </nav>
    </div>
    <main class="content">
        <div class="header">
            <h2>Credit Memo Details</h2>
        </div>
    </main>
    <div class="ordertable">
        <table class="styled-table" id="creditMemoTable">
            <thead>
                <tr>
                    <th>No.</th>
                    <th>Location Code</th>
                    <th>Document Date</th>
                    <th>Due Date</th>
                    <th>Amount</th>
                    <th>Ship to Address</th>
                    <th>Ship to City</th>
                    <th>Status</th>
                    <th>Download</th>
                </tr>
            </thead>
            <tbody>
                <!-- Data rows will be added here dynamically -->
            </tbody>
        </table>
    </div>



    <script>
        const UniqueNo = sessionStorage.getItem("UniqueNo");
        const UserType = sessionStorage.getItem("UserType");
        const loadingOverlay = document.getElementById("loading");
        let timeout;
        const menuButton = document.getElementById('menu-toggle');
        const sidebar = document.getElementById('sidebar');


        // Toggle sidebar visibility for small screens
        menuButton.addEventListener('click', () => {
            if (window.innerWidth <= 768) { // Apply only for small screens
                if (sidebar.classList.contains('sidebar-visible')) {
                    sidebar.classList.remove('sidebar-visible');
                } else {
                    sidebar.classList.add('sidebar-visible');
                }
            }
        });

        // Ensure correct sidebar state on window resize
        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                // Ensure sidebar is visible and reset styles
                sidebar.classList.add('sidebar-visible');
                sidebar.style.transform = ''; // Reset transform property
            } else {
                // Ensure sidebar is hidden initially on small screens
                sidebar.classList.remove('sidebar-visible');
            }
        });

        function startSessionTimeout() {
            // Clear any existing timeout
            clearTimeout(timeout);

            // Set a new timeout for logout
            timeout = setTimeout(() => {
                alert("Session expired due to inactivity.");
                sessionStorage.clear();
                window.location.href = "@($"{API_BASE_URL}")";
            }, 300000);
        }

        // Reset session timer on activity
        function resetSessionTimeout() {
            startSessionTimeout();
        }

        // Add event listeners for user activity
        document.addEventListener("mousemove", resetSessionTimeout);
        document.addEventListener("keypress", resetSessionTimeout);

        // Start the initial session timeout when the page loads
        startSessionTimeout();
        function logout() {
            // Clear the token or session data Or localStorage, depending on where the token is stored
            sessionStorage.removeItem("userData");
            fetch("@($"{API_BASE_URL}")/Home/Logout", {
                method: "POST",
                credentials: "include"  // Include cookies if necessary for the server session
            })
                .then(response => {
                    if (response.ok) {
                        // Redirect to login page after successful logout
                        sessionStorage.clear();
                        window.location.href = "@($"{API_BASE_URL}")";
                    } else {
                        console.error("Failed to log out");
                    }
                })
                .catch(error => {
                    console.error("Logout error:", error);
                });
        }
        async function fetchDataAndPopulateTable() {

            try {
                // Retrieve and parse data from sessionStorage
                const response = await fetch(`@($"{API_BASE_URL}")/api/Account/CreditMemo?No=${UniqueNo}&Type=${UserType}`, {
                    method: "GET",
                    headers: {
                    "X-API-KEY": `@($"{API_KEY}")`,
                    "X-API-PASSWORD": `@($"{API_VALUE}")`
                    }
                });

                if (!response.ok) {
                    throw new Error(`Error: ${response.status}`);
                }

                // Parse the JSON data
                const data = await response.json();

                if (data && data.length > 0) {
                    // Get the table body element
                    const tableBody = document.getElementById("creditMemoTable").getElementsByTagName("tbody")[0];

                    // Clear any existing rows
                    tableBody.innerHTML = "";

                    // Loop through each item in the data and add it to the table
                    data.forEach((item) => {
                        // Create a new row
                        const row = document.createElement("tr");

                        // Populate cells with data
                        row.innerHTML = `
                    <td>${item.no || "N/A"}</td>
                    <td>${item.locationCode || "N/A"}</td>
                    <td>${item.documentDate || "N/A"}</td>
                    <td>${item.dueDate || "N/A"}</td>
                    <td>${item.amount || "N/A"}</td>
                    <td>${item.shipToAddress || "N/A"}</td>
                    <td>${item.shipToCity || "N/A"}</td>
                    <td class="${item.status === 'Open' ? 'status-open' : ''}">${item.status || "N/A"}</td>
                    <td><button class="download-button" onclick="downloadReport('${item.no}')">Download</button></td>`;

                        // Append the row to the table body
                        tableBody.appendChild(row);
                    });
                }
                else {
                    // If no data, display a message
                    document.getElementById("creditMemoTable").getElementsByTagName("tbody")[0].innerHTML = "<tr><td colspan='8'>No data available</td></tr>";
                }
            }

            catch (error) {
                console.error("Error fetching data:", error);
                const tableBody = document.getElementById("creditMemoTable").getElementsByTagName("tbody")[0];
                tableBody.innerHTML = "<tr><td colspan='8'>Error fetching data</td></tr>";
            }
        }
        // Function to call the API to download the report
        async function downloadReport(credit_memo_No) {
            loadingOverlay.style.display = "flex";
            const response = await fetch(`@($"{API_BASE_URL}")/api/Account/DownloadCreditMemoReport/${credit_memo_No}?Type=${UserType}`, {
                method: 'GET',
                headers: { 'Accept': 'application/json',
                            "X-API-KEY": `@($"{API_KEY}")`,
                            "X-API-PASSWORD": `@($"{API_VALUE}")` }
            });

            if (response.ok) {
                const data = await response.json();
                loadingOverlay.style.display = "none";
                if (data.base64) {

                    const byteCharacters = atob(data.base64);

                    // Convert the byte characters to an array of bytes
                    const byteNumbers = Array.from(byteCharacters).map(char => char.charCodeAt(0));
                    const byteArray = new Uint8Array(byteNumbers);

                    // Create a Blob from the byte array and specify the MIME type as PDF
                    const blob = new Blob([byteArray], { type: 'application/pdf' });

                    // Create a URL for the Blob and initiate a download
                    const downloadUrl = URL.createObjectURL(blob);
                    const link = document.createElement('a');
                    link.href = downloadUrl;
                    link.download = `CRE_${credit_memo_No}.pdf`;  // The name of the file to be downloaded
                    document.body.appendChild(link);
                    link.click();

                    // Clean up: revoke the object URL and remove the temporary link element
                    URL.revokeObjectURL(downloadUrl);
                    document.body.removeChild(link);
                } else {
                    loadingOverlay.style.display = "none";
                    alert("File download failed.");
                }
            } else {
                loadingOverlay.style.display = "none";
                alert("Failed to retrieve the file.");
            }
        }
        window.addEventListener("load", fetchDataAndPopulateTable);

        document.getElementById("Credit_Memo-link").addEventListener("click", function (event) {
            event.preventDefault(); // Prevent the default link action
            document.getElementById("loading").style.display = "flex"; // Show loading indicator
            setTimeout(() => {
                location.reload(); // Refresh the page after a short delay
            }, 500); // Delay to allow the loading indicator to show
        });

    </script>
    <script src="~/assets/js/plugin/webfont/webfont.min.js"></script>
</body>

</html>
