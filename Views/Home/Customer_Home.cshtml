@{
  ViewData["Title"] = "Home";
}
@inject IConfiguration Configuration
@{
  var API_BASE_URL = $"{Configuration["API_BASE_URL"]}";
  var API_KEY = Configuration.GetSection("ApiSettings").GetValue<string>("ApiKey");
  var API_VALUE = Configuration.GetSection("ApiSettings").GetValue<string>("ApiPassword");
}
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - MyPortal</title>

  <link rel="stylesheet" href="~/css/Customer_Home.css" asp-append-version="true" />
  <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <!-- Bootstrap CSS -->
  @* <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet"> *@

  <!-- FontAwesome -->
  @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"> *@

</head>

<body>

  <div id="loading" class="loading" style="display: none;">
    <div class="spinner"></div>
    <p>Loading...</p>
  </div>
  @* <button id="toggleSidebar" class="btn btn-primary toggle-button" type="button">
    <i class="fas fa-bars"></i>
  </button> *@
  <div class="container-fluid">
    <div class="row">
      <div class="mobile-header">
        <button id="menu-toggle" class="menu-toggle">
          <i class="fas fa-bars"></i>
        </button>
      </div>
      <!-- Sidebar -->
      <nav class="col-md-3 col-lg-2 sidebar d-flex flex-column" id="sidebar">
        <ul class="nav flex-column">
          <li class="nav-item mt-3">
            <a href="#" id="Customer_Home-link"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a>
          </li>
          <li class="nav-item">
            <a href="@($"{API_BASE_URL}/Home/Orders")"><i class="fas fa-users me-2"></i>Orders</a>
          </li>
          <li class="nav-item">
            <a href="@($"{API_BASE_URL}/Home/Invoices")"><i class="fa-solid fa-file-lines me-2"></i>Invoices</a>
          </li>
          <li class="nav-item">
            <a href="@($"{API_BASE_URL}/Home/Quotes")"><i class="fa-solid fa-pen-to-square me-2"></i>Quotes</a>
          </li>
          <li class="nav-item">
            <a href="@($"{API_BASE_URL}/Home/Credit_Memo")"><i class="fa-solid fa-book me-2"></i>Credit Memo</a>
          </li>
          <li class="mt-auto nav-item">
            <button class="logout-button" onclick="logout()">
              <i class="fas fa-sign-out-alt me-2"></i> Logout
            </button>
          </li>
        </ul>

      </nav>

      <!-- Main Content -->
      <main class="col-md-9 col-lg-10 bg-light py-3">
        <!-- Header -->
        <div class="header_container">
          <div class="header mb-4">
            <h2>Welcome, <span id="headername">Guest</span>!</h2>
            <!-- <button class="btn btn-primary" onclick="openModal()">Download Statement</button> -->
          </div>
          <div class="header mb-4">
            <h3 id="customer_details">Details</h3>
            <button class="statement-button" id="customer_statement" onclick="openModal()">Download Statement</button>
            <button class="statement-button" id="vendor_details" onclick="DownloadVendorDetails()">Download Supplier
              Ledger</button>
            @* <button class="statement-button" data-bs-toggle="modal" data-bs-target="#download_statement">Download Statement</button> *@

          </div>
        </div>
        <!-- Modal for date selection -->
        <div id="dateModal" class="modal">
          <div class="smallmodal-content">
            <span class="close-btn" onclick="closeModal()">&times;</span>
            <h3>Select Date Range</h3>
            <label for="startDate">Start Date:</label>
            <input type="date" id="startDate" onchange="validateDates()" required>
            <label for="endDate">End Date:</label>
            <input type="date" id="endDate" onchange="validateDates()" max="" required>
            <button onclick="downloadCustomerStatement()">Download</button>
          </div>
        </div>

        <!-- Tiles -->
        <div class="row g-4">
          <div class="col-sm-6 col-md-3">
            <div class="tile" onclick="window.location.href='/Home/Orders';" style="cursor: pointer;">
              <h4 id="orderTitle">Orders</h4>
              <p class="count" id="orderCount">-</p>
              <div class="underline"></div>
              <div class="arrow">&gt;</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="tile" onclick="window.location.href='/Home/Invoices';" style="cursor: pointer;">
              <h4 id="purchaseTitle">Invoices</h4>
              <p class="count" id="invoiceCount">-</p>
              <div class="underline"></div>
              <div class="arrow">&gt;</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="tile">
              <h4>Next Due Date</h4>
              <p class="count" id="earliestpaymentdate">-</p>
              <div class="underline"></div>
              <div class="arrow">&gt;</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="tile">
              <h4>Next Due Amount</h4>
              <p class="count" id="earliestpaymentamount">-</p>
              <div class="underline"></div>
              <div class="arrow">&gt;</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="tile" onclick="window.location.href='/Home/Quotes';" style="cursor: pointer;">
              <h4 id="quoteTitle">Quotes</h4>
              <p class="count" id="quotecount">-</p>
              <div class="underline"></div>
              <div class="arrow">&gt;</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="tile" onclick="window.location.href='/Home/Credit_memo';" style="cursor: pointer;">
              <h4 id="credit_memoTitle">Credit Memo</h4>
              <p class="count" id="credit_memocount">-</p>
              <div class="underline"></div>
              <div class="arrow">&gt;</div>
            </div>
          </div>
        </div>


        <!-- General Information -->
        <div class="container-fluid my-4">
          <!-- General Information Section -->
          <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
              <h3 class="h5 text-dark">General Information</h3>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <!-- First Column -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">No:</p>
                    <p class="mb-0 text-muted value" id="no">Loading...</p>
                  </div>
                </div>
                <!-- Second Column -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Name:</p>
                    <p class="mb-0 text-muted value" id="name">Loading...</p>
                  </div>
                </div>
                <!-- Third Column -->
                <div class="col-lg-6 col-md-12" id="sales_balance">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Balance:</p>
                    <p class="mb-0 text-muted value" id="balance">Loading...</p>
                  </div>
                </div>
                <!-- Fourth Column -->
                <div class="col-lg-6 col-md-12" id="sales_balance_due">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Balance Due:</p>
                    <p class="mb-0 text-muted value" id="balance_due">Loading...</p>
                  </div>
                </div>
                <!-- Fifth Column -->
                <div class="col-lg-6 col-md-12" id="sales_credit_limit">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Credit Limit ($):</p>
                    <p class="mb-0 text-muted value" id="credit_limit">Loading...</p>
                  </div>
                </div>
                <!-- Sixth Column -->
                <div class="col-lg-6 col-md-12" id="sales_total_sales">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Total Sales:</p>
                    <p class="mb-0 text-muted value" id="total_sales">Loading...</p>
                  </div>
                </div>
                <div class="col-lg-6 col-md-12" id="purchase_total_purchase">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Total Purchase:</p>
                    <p class="mb-0 text-muted value" id="total_purchase">Loading...</p>
                  </div>
                </div>
                <div class="col-lg-6 col-md-12" id="purchase_vat_registration">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">VAT Registration:</p>
                    <p class="mb-0 text-muted value" id="vat_registration">Loading...</p>
                  </div>
                </div>
                <div class="col-lg-6 col-md-12" id="purchase_federalIdNo">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Federal ID No:</p>
                    <p class="mb-0 text-muted value" id="federalNo">Loading...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Address Section -->
          <div class="card shadow-sm">
            <div class="card-header bg-white">
              <h3 class="h5 text-dark">Address</h3>
            </div>
            <div class="card-body">
              <div class="row g-3">
                <!-- Address 1 -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Address:</p>
                    <p class="mb-0 text-muted value" id="address">Loading...</p>
                  </div>
                </div>
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Postcode:</p>
                    <p class="mb-0 text-muted value" id="post_code">Loading...</p>
                  </div>
                </div>
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Address 2:</p>
                    <p class="mb-0 text-muted value" id="address2">Loading...</p>
                  </div>
                </div>
                <!-- Country/Region Code -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Country/Region Code:</p>
                    <p class="mb-0 text-muted value" id="country_code">Loading...</p>
                  </div>
                </div>
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">City:</p>
                    <p class="mb-0 text-muted value" id="city">Loading...</p>
                  </div>
                </div>
                <!-- Phone No -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Phone No:</p>
                    <p class="mb-0 text-muted value" id="phone_no">Loading...</p>
                  </div>
                </div>
                <!-- Country/Region Code -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">State:</p>
                    <p class="mb-0 text-muted value" id="state">Loading...</p>
                  </div>
                </div>
                <!-- Location Code -->
                <div class="col-lg-6 col-md-12">
                  <div class="d-flex justify-content-between p-2 rounded user-detail-item">
                    <p class="fw-bold mb-0 key">Email:</p>
                    <p class="mb-0 text-muted value" id="email">Loading...</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </main>
    </div>
  </div>

  <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>

  <script>
    const UniqueNo = sessionStorage.getItem("UniqueNo");
    const UserType = sessionStorage.getItem("UserType");
    const loadingOverlay = document.getElementById("loading");
    const menuButton = document.getElementById('menu-toggle');
    const sidebar = document.getElementById('sidebar');

    sessionStorage.setItem("PreviousPage", "dashboard");

    var cust_details = document.getElementById("customer_details");
    document.addEventListener("DOMContentLoaded", function () {
      if (UserType === 'Customer') {
        const vender_details_btn = document.getElementById("vendor_details");
        if (vender_details_btn) {
          vender_details_btn.remove();
        }
        cust_details.textContent = "Customer Details";
        document.getElementById("quoteTitle").closest(".col-sm-6").style.display = "none";
        document.getElementById("credit_memoTitle").closest(".col-sm-6").style.display = "none";
        var purchase_total_purchase = document.getElementById("purchase_total_purchase");
        var purchase_vat_registration = document.getElementById("purchase_vat_registration");
        var purchase_federalIdNo = document.getElementById("purchase_federalIdNo");
        purchase_total_purchase.style.display = 'none';
        purchase_vat_registration.style.display = 'none';
        purchase_federalIdNo.style.display = 'none';
      }
      else {
        cust_details.textContent = "Supplier Details";
        // Remove or hide specific tiles for vendor login
        document.getElementById("earliestpaymentdate").closest(".col-sm-6").style.display = "none";
        document.getElementById("earliestpaymentamount").closest(".col-sm-6").style.display = "none";
        const customer_statement_btn = document.getElementById("customer_statement");
        if (customer_statement_btn) {
          customer_statement_btn.style.display = "none";
        }
        var sales_balance = document.getElementById("sales_balance");
        var sales_balance_due = document.getElementById("sales_balance_due");
        var sales_credit_limit = document.getElementById("sales_credit_limit");
        var sales_total_sales = document.getElementById("sales_total_sales");
        sales_balance.style.display = 'none';
        sales_balance_due.style.display = 'none';
        sales_credit_limit.style.display = 'none';
        sales_total_sales.style.display = 'none';
      }
    });

    // Toggle sidebar visibility for small screens
    menuButton.addEventListener('click', () => {
      if (window.innerWidth <= 768) { // Apply only for small screens
        if (sidebar.classList.contains('sidebar-visible')) {
          sidebar.classList.remove('sidebar-visible');
        } else {
          sidebar.classList.add('sidebar-visible');
        }
      }
    });

    // Ensure correct sidebar state on window resize
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768) {
        // Ensure sidebar is visible and reset styles
        sidebar.classList.add('sidebar-visible');
        sidebar.style.transform = ''; // Reset transform property
      } else {
        // Ensure sidebar is hidden initially on small screens
        sidebar.classList.remove('sidebar-visible');
      }
    });

    async function DownloadVendorDetails() {
      // Make API call with the selected date range
      try {
        loadingOverlay.style.display = "flex";
        const response = await fetch(`@($"{API_BASE_URL}")/api/Account/DownloadVendorDetails/${UniqueNo}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

        if (response.ok) {
          const data = await response.json();
          loadingOverlay.style.display = "none";
          if (data.base64) {
            const byteCharacters = atob(data.base64);
            const byteNumbers = Array.from(byteCharacters).map(char => char.charCodeAt(0));
            const byteArray = new Uint8Array(byteNumbers);
            const blob = new Blob([byteArray], { type: 'application/pdf' });
            const downloadUrl = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = downloadUrl;
            link.download = `VEN_ACC_${UniqueNo}.pdf`;
            document.body.appendChild(link);
            link.click();

            URL.revokeObjectURL(downloadUrl);
            document.body.removeChild(link);
          } else {
            alert("File download failed.");
          }
        } else {
          alert("Failed to retrieve the file.");
        }
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred while downloading the statement.");
      }
    }
    function openModal() {
      document.getElementById("dateModal").style.display = "block";
      // Set the maximum selectable date for today
      const stoday = new Date().toISOString().split("T")[0];
      document.getElementById("startDate").setAttribute("max", stoday);
      const etoday = new Date().toISOString().split("T")[0];
      document.getElementById("endDate").setAttribute("max", etoday);
    }
    function closeModal() {
      document.getElementById("dateModal").style.display = "none";
    }
    function validateDates() {
      const startDate = document.getElementById("startDate").value;
      const endDate = document.getElementById("endDate").value;
      const today = new Date().toISOString().split("T")[0];

      // Ensure end date is not in the future
      if (endDate && new Date(endDate) > new Date(today)) {
        document.getElementById("endDate").value = today;
        alert("End date cannot be a future date.");
      }

      // Ensure start date is not after the end date
      if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
        document.getElementById("endDate").value = startDate;
        alert("End date cannot be earlier than start date.");
      }
    }
    async function downloadCustomerStatement() {
      const startDate = document.getElementById("startDate").value;
      const endDate = document.getElementById("endDate").value;
      const today = new Date().toISOString().split("T")[0];
      // Ensure end date is not in the future
      if (endDate && new Date(endDate) > new Date(today)) {
        document.getElementById("endDate").value = today;
        alert("End date cannot be a future date.");
      }
      if (!startDate || !endDate) {
        alert("Please select both start and end dates.");
        return;
      }
      // Make API call with the selected date range
      try {
        loadingOverlay.style.display = "flex";
        const response = await fetch(`@($"{API_BASE_URL}")/api/Account/DownloadCustomerStatements/${UniqueNo}`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-API-KEY": `@($"{API_KEY}")`,
            "X-API-PASSWORD": `@($"{API_VALUE}")`
          },
          body: JSON.stringify({ startDate, endDate }),
        });

        if (response.ok) {
          const data = await response.json();
          loadingOverlay.style.display = "none";
          if (data.base64) {
            const byteCharacters = atob(data.base64);
            const byteNumbers = Array.from(byteCharacters).map(char => char.charCodeAt(0));
            const byteArray = new Uint8Array(byteNumbers);
            const blob = new Blob([byteArray], { type: 'application/pdf' });
            const downloadUrl = URL.createObjectURL(blob);
            const link = document.createElement('a');
            link.href = downloadUrl;
            link.download = `CUST_STAT_${UniqueNo}.pdf`;
            document.body.appendChild(link);
            link.click();

            URL.revokeObjectURL(downloadUrl);
            document.body.removeChild(link);
            closeModal();
          } else {
            alert("File download failed.");
          }
        } else {
          alert("Failed to retrieve the file.");
        }
      } catch (error) {
        console.error("Error:", error);
        alert("An error occurred while downloading the statement.");
      }
    }



    history.pushState({}, '', '/Home/Customer_Home');



    // Function to fetch data and get the count
    async function fetchOrdersCount() {
      try {
        if (UniqueNo !== null) {
          const response = await fetch(`@($"{API_BASE_URL}")/api/Account/Orders?No=${UniqueNo}&Type=${UserType}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

          if (!response.ok) {

            throw new Error(`Error: ${response.status}`);
          }
          const data = await response.json();

          //sessionStorage.setItem("allorders", JSON.stringify(data));
          // Get the count of items in the array
          const totalCount = data.length;

          document.getElementById('orderCount').textContent = totalCount;
        }
      }

      catch (error) {
        console.error("Error fetching data:", error);
      }
    }
    async function fetchInvoiceCount() {
      try {
        if (UniqueNo !== null) {
          const response = await fetch(`@($"{API_BASE_URL}")/api/Account/Invoices?No=${UniqueNo}&Type=${UserType}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

          if (!response.ok) {

            throw new Error(`Error: ${response.status}`);
          }
          const data = await response.json();
          const totalCount = data.length;

          document.getElementById('invoiceCount').textContent = totalCount;
        }
      }
      catch (error) {
        console.error("Error fetching data:", error);
      }
    }

    // Call the function when needed (e.g., on page load)
    if (UserType === 'Customer') {
      async function fetchEarliestPaymentDate() {
        try {
          if (UniqueNo !== null) {
            const response = await fetch(`@($"{API_BASE_URL}")/api/Account/EarliestPaymentDate?No=${UniqueNo}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

            if (!response.ok) {

              throw new Error(`Error: ${response.status}`);
            }
            const data = await response.json();

            document.getElementById('earliestpaymentdate').textContent = data.date;
          }
        }
        catch (error) {
          console.error("Error fetching data:", error);
        }
      }
      async function fetchEarliestPaymentAmount() {
        try {
          if (UniqueNo !== null) {
            const response = await fetch(`@($"{API_BASE_URL}")/api/Account/EarliestPaymentAmount?No=${UniqueNo}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

            if (!response.ok) {

              throw new Error(`Error: ${response.status}`);
            }
            const data = await response.json();

            document.getElementById('earliestpaymentamount').textContent = data;
          }
        }
        catch (error) {
          console.error("Error fetching data:", error);
        }
      }
      window.addEventListener("load", fetchOrdersCount);
      window.addEventListener("load", fetchInvoiceCount);
      window.addEventListener("load", fetchEarliestPaymentDate);
      window.addEventListener("load", fetchEarliestPaymentAmount);
    }
    else {
      async function fetchQuoteCount() {
        try {
          if (UniqueNo !== null) {
            const response = await fetch(`@($"{API_BASE_URL}")/api/Account/Quotes?No=${UniqueNo}&Type=${UserType}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

            if (!response.ok) {

              throw new Error(`Error: ${response.status}`);
            }
            const data = await response.json();

            //sessionStorage.setItem("allorders", JSON.stringify(data));
            // Get the count of items in the array
            const totalCount = data.length;

            document.getElementById('quotecount').textContent = totalCount;
          }
        }

        catch (error) {
          console.error("Error fetching data:", error);
        }
      }
      async function fetchCreditMemoCount() {
        try {
          if (UniqueNo !== null) {
            const response = await fetch(`@($"{API_BASE_URL}")/api/Account/CreditMemo?No=${UniqueNo}&Type=${UserType}`, {
            method: "GET",
            headers: {
              "X-API-KEY": `@($"{API_KEY}")`,
              "X-API-PASSWORD": `@($"{API_VALUE}")`
            }
          });

            if (!response.ok) {

              throw new Error(`Error: ${response.status}`);
            }
            const data = await response.json();

            //sessionStorage.setItem("allorders", JSON.stringify(data));
            // Get the count of items in the array
            const totalCount = data.length;

            document.getElementById('credit_memocount').textContent = totalCount;
          }
        }

        catch (error) {
          console.error("Error fetching data:", error);
        }
      }
      window.addEventListener("load", fetchOrdersCount);
      window.addEventListener("load", fetchInvoiceCount);
      window.addEventListener("load", fetchQuoteCount);
      window.addEventListener("load", fetchCreditMemoCount);
    }
    @* window.addEventListener("load", updateUserInfo); *@

      let timeout;

    function startSessionTimeout() {
      // Clear any existing timeout
      clearTimeout(timeout);
      // Set a new timeout for logout
      timeout = setTimeout(() => {
        alert("Session expired due to inactivity.");
        sessionStorage.clear();
        window.location.href = "@($"{API_BASE_URL}")";
      }, 300000);
    }

    // Reset session timer on activity
    function resetSessionTimeout() {
      startSessionTimeout();
    }

    // Add event listeners for user activity
    document.addEventListener("mousemove", resetSessionTimeout);
    document.addEventListener("keypress", resetSessionTimeout);

    // Start the initial session timeout when the page loads
    startSessionTimeout();

    document.addEventListener("DOMContentLoaded", function () {
      fetch(`@($"{API_BASE_URL}")/api/Account/TypeBaseLogin?No=${UniqueNo}&Type=${UserType}`, {
        method: "GET",
        headers: {
          "Content-Type": "application/json",
          "X-API-KEY": `@($"{API_KEY}")`,
          "X-API-PASSWORD": `@($"{API_VALUE}")`
        }
      })
        .then(response => {
          console.log("Fetch request completed.");

          if (response.status === 401) {
            // Show login failed message for invalid credentials
            Toastify({
              text: "Invalid username or password",
              duration: 3000,
              close: true,
              gravity: "top",
              position: "right",
              backgroundColor: "red",
            }).showToast();

            throw new Error("Invalid username or password");
          }
          else if (response.status !== 200) {
            // Show login failed message for invalid credentials
            Toastify({
              text: "Login failed: " + response.status,
              duration: 3000,
              close: true,
              gravity: "top",
              position: "right",
              backgroundColor: "red",
            }).showToast();

            throw new Error("Login failed");
          }

          // For successful response (200)
          return response.json();
        })
        .then(data => {
          const UserData = JSON.stringify(data);
          const UserUnique = JSON.parse(UserData);
          if (UserUnique) {

            document.getElementById("no").textContent = UserUnique.no || "N/A";
            document.getElementById("name").textContent = UserUnique.name || "N/A";
            document.getElementById("headername").textContent = UserUnique.name || "N/A";


            if (UserType === "Customer") {
              document.getElementById("balance").textContent = UserUnique.balanceLCY || "N/A";
              document.getElementById("balance_due").textContent = UserUnique.balanceDueLCY || "N/A";
              document.getElementById("credit_limit").textContent = UserUnique.creditLimitLCY || "N/A";
              document.getElementById("total_sales").textContent = UserUnique.salesLCY || "N/A";

            }
            else {
              document.getElementById("total_purchase").textContent = UserUnique.purchasesLCY || "N/A";
              document.getElementById("vat_registration").textContent = UserUnique.vatRegistrationNo || "N/A";
              document.getElementById("federalNo").textContent = UserUnique.federalIDNo || "N/A";

            }


            // address data
            document.getElementById("address").textContent = UserUnique.address || "N/A";
            document.getElementById("address2").textContent = UserUnique.address2 || "N/A";
            document.getElementById("city").textContent = UserUnique.city || "N/A";
            document.getElementById("state").textContent = UserUnique.county || "N/A";
            document.getElementById("post_code").textContent = UserUnique.postCode || "N/A";
            document.getElementById("country_code").textContent = UserUnique.countryRegionCode || "N/A";
            document.getElementById("phone_no").textContent = UserUnique.phoneNo || "N/A";
            document.getElementById("email").textContent = UserUnique.eMail || "N/A";


          } else {
            document.getElementById("userData").textContent = "No data found!";
          }

        })

    });
    // Refresh the Customer_Home on clicking the Customer_Home link
    document.getElementById("Customer_Home-link").addEventListener("click", function (event) {
      event.preventDefault(); // Prevent the default link action
      document.getElementById("loading").style.display = "flex"; // Show loading indicator
      setTimeout(() => {
        location.reload(); // Refresh the page after a short delay
      }, 500); // Delay to allow the loading indicator to show
    });

    // onclick event on Logout button
    function logout() {
      // Clear the token or session data Or localStorage, depending on where the token is stored
      sessionStorage.removeItem("isLoggedIn");
      sessionStorage.clear();
      window.location.href = "@($"{API_BASE_URL}")";
    }





  </script>


